# Copy to .env.local and fill in values.
# Local app: npm run dev → http://localhost:3000

# --- Required for core app ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NVIDIA_API_KEY=nvapi-...
# Optional override (default: meta/llama-3.1-70b-instruct)
# NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct

# --- Required for auth-protected flows (signup, save profile, matches feedback) ---
# Enable Email provider in Supabase Dashboard first.

# --- Required for manual job seeding & cron routes ---
CRON_SECRET=local-dev-secret-change-me

# --- Local URL (UI only; Apify webhooks need ngrok — see docs/LOCAL_DEBUG.md) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: Apify async pipeline ---
# APIFY_API_TOKEN=
# APIFY_WEBHOOK_SECRET=
# APIFY_ACTOR_ID=bebity/linkedin-jobs-scraper
# APIFY_SEARCH_KEYWORDS=software engineer
# APIFY_SEARCH_LOCATION=Hong Kong
# APIFY_MAX_ITEMS=30
# APIFY_ACTOR_LINKEDIN=bebity/linkedin-jobs-scraper
# APIFY_ACTOR_JOBSDB=junglee/jobsdb-scraper
# APIFY_ACTOR_INDEED=misceres/indeed-scraper
# APIFY_ACTOR_GOOGLE=johnvc/google-jobs-scraper

# Match tuning (Hong Kong defaults)
# MATCH_THRESHOLD=0.62
# DEFAULT_JOB_REGION=Hong Kong

# Python scraper (local dev — Indeed, JobsDB, agencies on upload)
# SCRAPER_ENABLED=true
# SCRAPER_SOURCES=indeed,jobsdb,jobs_gov,michael_page,hkslash
# SCRAPER_MAX_PER_SOURCE=5

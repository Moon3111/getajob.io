# Copy to .env.local and fill in values.
# Local app: npm run dev → http://localhost:3000

# --- Required for core app ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NVIDIA_API_KEY=nvapi-...

# --- Required for auth-protected flows (signup, save profile, matches feedback) ---
# Enable Email provider in Supabase Dashboard first.

# --- Required for manual job seeding & cron routes ---
CRON_SECRET=local-dev-secret-change-me

# --- Local URL (UI only; Apify webhooks need ngrok — see docs/LOCAL_DEBUG.md) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: Apify async pipeline ---
# APIFY_API_TOKEN=
# APIFY_WEBHOOK_SECRET=
# APIFY_ACTOR_ID=bebity/linkedin-jobs-scraper
# APIFY_SEARCH_KEYWORDS=software engineer
# APIFY_SEARCH_LOCATION=Australia
# APIFY_MAX_ITEMS=50

# Copy to scraper/.env (or use project root .env.local values)

# Where to POST scraped jobs (local dev or production)
INGEST_URL=http://localhost:3000/api/ingest-jobs
CRON_SECRET=local-dev-secret-change-me

# Search (Hong Kong defaults)
SCRAPE_KEYWORDS=software engineer
SCRAPE_LOCATION=Hong Kong
MAX_JOBS_PER_SOURCE=20

# Slow down requests (seconds between detail-page visits)
REQUEST_DELAY_SEC=1.5

# Headless browser (set false to debug visually)
HEADLESS=true

# Optional: LinkedIn session cookie (li_at) — only if you accept LinkedIn ToS risk
# LINKEDIN_LI_AT=

# Sources (no bing/google): see scraper/README.md
SCRAPE_SOURCES=indeed,jobsdb,jobs_gov,michael_page,randstad,hkslash

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key
# Default chat model: meta/llama-3.1-70b-instruct (enable on build.nvidia.com)
# NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct

# Protect cron routes (/api/ingest-jobs, /api/cron/fetch-jobs)
CRON_SECRET=generate-a-long-random-string

# Public app URL for Apify webhooks (required in production)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APIFY_WEBHOOK_SECRET=generate-a-long-random-string

# Apify (https://console.apify.com)
APIFY_API_TOKEN=apify_api_your_token
APIFY_ACTOR_ID=bebity/linkedin-jobs-scraper
APIFY_SEARCH_KEYWORDS=software engineer
APIFY_SEARCH_LOCATION=Hong Kong
APIFY_MAX_ITEMS=30
APIFY_ACTOR_LINKEDIN=bebity/linkedin-jobs-scraper
APIFY_ACTOR_JOBSDB=junglee/jobsdb-scraper
APIFY_ACTOR_INDEED=misceres/indeed-scraper
APIFY_ACTOR_GOOGLE=johnvc/google-jobs-scraper

MATCH_THRESHOLD=0.62
DEFAULT_JOB_REGION=Hong Kong
